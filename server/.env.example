# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# MongoDB Atlas connection string. Replace <user>:<password> and cluster info.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# ---- Auth ----
# Any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- CORS ----
CLIENT_URL=http://localhost:5173

# ---- Admin (used by the one-time init-admin script) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# ---- Email / SMTP (optional but recommended) ----
# Leave SMTP_HOST empty to disable email notifications; contact messages still save to MongoDB.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=laxmantarihalkar05@gmail.com
CONTACT_NOTIFY_EMAIL=laxmantarihalkar05@gmail.com
